---
import { content } from '../data/content';
import T from './T.astro';
const { about } = content;
---

<section class="section about" id="about">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-index"><T t={about.label} /></span>
    </div>

    <div class="about__grid">
      <aside class="about__aside reveal">
        <ul class="about__highlights">
          {about.highlights.map((h) => (
            <li>
              <span class="about__value display">{h.value}</span>
              <span class="about__hlabel"><T t={h.label} /></span>
            </li>
          ))}
        </ul>
      </aside>

      <div class="about__body">
        <p class="about__lead reveal"><T t={about.lead} /></p>

        {about.paragraphs.map((p, i) => (
          <p class="about__p reveal" style={`--reveal-delay: ${0.05 + i * 0.05}s`}>
            <T t={p} />
          </p>
        ))}

        <ul class="about__skills reveal">
          {about.skills.map((skill) => (
            <li><T t={skill} /></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about { background: var(--paper-2); }
  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  /* Aside / highlights */
  .about__highlights {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .about__highlights li { display: flex; flex-direction: column; gap: 0.2rem; }
  .about__value {
    font-size: var(--step-3);
    line-height: 1;
    color: var(--ink);
    font-weight: 460;
  }
  .about__hlabel {
    font-size: var(--step--1);
    color: var(--muted);
    letter-spacing: 0.04em;
    max-width: 14ch;
  }

  /* Body */
  .about__lead {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.18;
    color: var(--ink);
    font-weight: 350;
    max-width: 18ch;
    margin-bottom: 1.8rem;
  }
  .about__p {
    color: var(--ink-soft);
    font-size: var(--step-0);
    max-width: 60ch;
  }
  .about__p + .about__p { margin-top: 1.1rem; }

  .about__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.4rem;
  }
  .about__skills li {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 0.4rem 1rem;
  }

  @media (min-width: 900px) {
    .about__grid { grid-template-columns: 0.32fr 0.68fr; align-items: start; }
    .about__highlights { flex-direction: column; gap: 1.8rem; position: sticky; top: 100px; }
    .about__lead { font-size: var(--step-4); }
  }
</style>
