---
import { content } from '../data/content';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <span class="footer__name">© {year} {content.meta.name}</span>
    <span class="footer__made" data-es="Diseñado y desarrollado con cuidado · Hecho en Perú" data-en="Designed & built with care · Made in Perú">
      Diseñado y desarrollado con cuidado · Hecho en Perú
    </span>
    <a href="#top" class="footer__top" data-es="Volver arriba ↑" data-en="Back to top ↑">Volver arriba ↑</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--dark-muted);
    border-top: 1px solid color-mix(in srgb, var(--dark-muted) 25%, transparent);
    padding-block: 2rem;
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--step--1);
  }
  .footer__top { transition: color 0.25s var(--ease); }
  .footer__top:hover { color: var(--dark-ink); }
</style>
